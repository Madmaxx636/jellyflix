<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers are often plain http on the local network, or use a certificate the owner added to the device. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

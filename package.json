{
  "name": "jellyflix",
  "version": "0.3.1",
  "description": "A Jellyfin desktop client that looks and works like Netflix, Hulu, HBO or Disney+",
  "private": true,
  "license": "MIT",
  "author": "Lane <16749601+Madmaxx636@users.noreply.github.com>",
  "engines": {
    "node": ">=22.12"
  },
  "main": "out/main/index.js",
  "desktopName": "jellyflix.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "pretest:e2e": "npm run build",
    "test:e2e": "node tests/e2e/features.mjs",
    "pretest:e2e:signin": "npm run build",
    "test:e2e:signin": "node tests/e2e/signin.mjs",
    "pretest:e2e:updates": "npm run build",
    "test:e2e:updates": "node tests/e2e/updates.mjs",
    "pretest:e2e:https": "npm run build",
    "test:e2e:https": "node tests/e2e/https.mjs",
    "dist": "npm run build && electron-builder",
    "prebuild": "node -e \"fs.rmSync('out',{recursive:true,force:true})\""
  },
  "build": {
    "appId": "app.jellyflix.desktop",
    "productName": "Jellyflix",
    "files": [
      "out/**",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ],
      "category": "AudioVideo",
      "maintainer": "Lane <16749601+Madmaxx636@users.noreply.github.com>",
      "syncDesktopName": true,
      "executableArgs": []
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Madmaxx636",
        "repo": "jellyflix"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hls.js": "^1.7.4",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
